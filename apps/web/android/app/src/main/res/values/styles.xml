<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/evoveBlack</item>
        <item name="android:statusBarColor">@color/evoveBlack</item>
        <item name="android:navigationBarColor">@color/evoveBlack</item>
    </style>

    <!-- The activity keeps this theme after launch (no splash-screen plugin is
         installed), so whatever sits behind the WebView is what shows while the
         bundle boots: the wordmark on black. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/launch_screen</item>
        <item name="windowSplashScreenBackground">@color/evoveBlack</item>
        <item name="android:statusBarColor">@color/evoveBlack</item>
        <item name="android:navigationBarColor">@color/evoveBlack</item>
    </style>
</resources>
